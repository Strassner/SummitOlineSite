# Production site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.summitlineacademy.com
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Optional: form service endpoint for the contact form (e.g. https://formspree.io/f/xxxxxxx).
# If blank, the form opens the visitor's email app addressed to the business email.
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Only for GitHub Pages project sites (set automatically by the deploy workflow): /<repo-name>
NEXT_PUBLIC_BASE_PATH=
